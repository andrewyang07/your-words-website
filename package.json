{
  "name": "your-words",
  "version": "1.3.0",
  "private": false,
  "license": "MIT",
  "description": "A beautiful Bible memorization app with Chinese and English support",
  "author": "andrewyang07",
  "homepage": "https://www.yourwords.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewyang07/your-words-website"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:presets && npm run search:build-index",
    "data:presets": "node scripts/build-preset-data.mjs",
    "build": "next build --webpack",
    "search:build-index": "node scripts/build-pagefind-index.mjs main && node scripts/build-pagefind-index.mjs pinyin 0 && node scripts/build-pagefind-index.mjs pinyin 1",
    "start": "next start",
    "lint": "eslint . && npm run lint:tw-opacity && npm run format:check",
    "lint:tw-opacity": "node scripts/check-tailwind-opacity.mjs",
    "test:unit": "vitest run --exclude 'tests/search-eval/**'",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude 'tests/search-eval/**'",
    "check": "npm run lint && npm run type-check && npm run test:unit",
    "prepare": "husky",
    "test:search-eval": "vitest run tests/search-eval"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.18",
    "@headlessui/react": "^2.2.9",
    "@mdxeditor/editor": "^3.55.0",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bible-passage-reference-parser": "^3.2.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "minisearch": "^7.2.0",
    "next": "16.3.8",
    "opencc-js": "^1.3.0",
    "pinyin-pro": "^3.28.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/opencc-js": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "postcss": "8.5.25",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
